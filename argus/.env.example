ARGUS_DB_URL=postgresql+psycopg2://argus:argus@db:5432/argus
ARGUS_WATCHLIST=config/watchlist.yaml
ARGUS_SOURCES=config/sources.yaml

# --- LLM (Increment 6) — wstaw realne klucze w .env na VPS ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ARGUS_LLM_ALLOW_PAID=false
ARGUS_LLM_PAID_MODEL=openai/gpt-4o-mini
ARGUS_LLM_MAX_PER_RUN=20   # globalny limit wywolan LLM na CALY przebieg rss-job (nie per-feed)
ARGUS_GEMINI_MODEL=gemini-flash-latest
ARGUS_OR_FREE_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Hyperstats leaderboard (Increment 7) ---
ARGUS_HYPERSTATS_TOP_N=20
ARGUS_HYPERSTATS_MIN_WINRATE=0.5
ARGUS_HYPERSTATS_MIN_TRADES=50
