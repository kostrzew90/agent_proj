# Skopiuj ten plik do .env i uzupełnij prawdziwymi danymi z panelu home.pl.
# Plik .env NIGDY nie powinien trafić do repozytorium (jest w .gitignore).
# Uruchomienie deployu: node --env-file=.env scripts/deploy.mjs

# Adres serwera FTP (z panelu home.pl, np. ftp.twojadomena.pl)
FTP_HOST=serwerXXXXXXX.hosting-home.pl

# Login konta FTP z panelu home.pl
FTP_USER=deploy@twojadomena.pl

# Hasło konta FTP — nie commituj tego pliku z prawdziwym hasłem!
FTP_PASSWORD=twoje-haslo-ftp

# Port FTP (opcjonalny, domyślnie 21)
FTP_PORT=21

# Czy używać FTPS (explicit AUTH TLS) — "true" (domyślnie) lub "false" dla zwykłego FTP
FTP_SECURE=true

# Katalog docelowy na serwerze (opcjonalny, domyślnie /public_html)
FTP_REMOTE_DIR=/public_html
